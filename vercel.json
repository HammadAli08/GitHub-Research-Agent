{
    "version": 2,
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "https://github-research-agent.onrender.com/$1"
        },
        {
            "source": "/(assets/.*)",
            "destination": "/$1"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ]
}